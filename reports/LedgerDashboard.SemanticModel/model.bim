            "sourceColumn": "MatchScore",
            "summarizeBy": "average"
          },
          {
            "name": "ScoreBucket",
            "dataType": "string",
            "sourceColumn": "ScoreBucket",
            "summarizeBy": "none",
            "sortByColumn": "ScoreBucketOrder"
          },
          {
            "name": "ScoreBucketOrder",
            "dataType": "int64",
            "sourceColumn": "ScoreBucketOrder",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "CurrentStage",
            "dataType": "string",
            "sourceColumn": "CurrentStage",
            "summarizeBy": "none"
          },
          {
            "name": "Outcome",
            "dataType": "string",
            "sourceColumn": "Outcome",
            "summarizeBy": "none"
          },
          {
            "name": "IsSent",
            "dataType": "boolean",
            "sourceColumn": "IsSent",
            "summarizeBy": "none"
          },
          {
            "name": "IsRejected",
            "dataType": "boolean",
            "sourceColumn": "IsRejected",
            "summarizeBy": "none"
          },
          {
            "name": "GotInterview",
            "dataType": "boolean",
            "sourceColumn": "GotInterview",
            "summarizeBy": "none"
          },
          {
            "name": "CreatedDate",
            "dataType": "dateTime",
            "sourceColumn": "CreatedDate",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "SentDate",
            "dataType": "dateTime",
            "sourceColumn": "SentDate",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "SentWeek",
            "dataType": "dateTime",
            "sourceColumn": "SentWeek",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "RejectedDate",
            "dataType": "dateTime",
            "sourceColumn": "RejectedDate",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "DaysToReject",
            "dataType": "int64",
            "sourceColumn": "DaysToReject",
            "summarizeBy": "average"
          },
          {
            "name": "FollowupCount",
            "dataType": "int64",
            "sourceColumn": "FollowupCount",
            "summarizeBy": "sum"
          },
          {
            "name": "HasFollowup",
            "dataType": "boolean",
            "sourceColumn": "HasFollowup",
            "summarizeBy": "none"
          },
          {
            "name": "HasContactEmail",
            "dataType": "boolean",
            "sourceColumn": "HasContactEmail",
            "summarizeBy": "none"
          },
          {
            "name": "ContactSource",
            "dataType": "string",
            "sourceColumn": "ContactSource",
            "summarizeBy": "none"
          },
          {
            "name": "NeedsFollowup",
            "dataType": "boolean",
            "sourceColumn": "NeedsFollowup",
            "summarizeBy": "none"
          },
          {
            "name": "DaysSinceAction",
            "dataType": "int64",
            "sourceColumn": "DaysSinceAction",
            "summarizeBy": "max"
          }
        ],
        "partitions": [
          {
            "name": "ApplicationFacts",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(SqlServer, SqlDatabase),",
                "    Data = Source{[Schema=\"rpt\",Item=\"ApplicationFacts\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Applications Sent",
            "expression": "CALCULATE ( COUNTROWS ( ApplicationFacts ), ApplicationFacts[IsSent] = TRUE () )",
            "formatString": "0",
            "displayFolder": "Pipeline"
          },
          {
            "name": "Rejected",
            "expression": "CALCULATE ( COUNTROWS ( ApplicationFacts ), ApplicationFacts[IsRejected] = TRUE () )",
            "formatString": "0",
            "displayFolder": "Pipeline"
          },
          {
            "name": "Rejection Rate",
            "expression": "DIVIDE ( [Rejected], [Applications Sent] )",
            "formatString": "0.0%",
            "displayFolder": "Pipeline"
          },
          {
            "name": "Awaiting Reply",
            "expression": "CALCULATE ( COUNTROWS ( ApplicationFacts ), ApplicationFacts[Outcome] = \"Awaiting reply\" )",
            "formatString": "0",
            "displayFolder": "Pipeline"
          },
          {
            "name": "Interviews",
            "expression": "CALCULATE ( COUNTROWS ( ApplicationFacts ), ApplicationFacts[GotInterview] = TRUE () )",
            "formatString": "0",
            "displayFolder": "Pipeline"
          },
          {
            "name": "Interview Rate",
            "expression": "DIVIDE ( [Interviews], [Applications Sent] )",
            "formatString": "0.0%",
            "displayFolder": "Pipeline"
          },
          {
            "name": "Avg Match Score",
            "expression": "AVERAGE ( ApplicationFacts[MatchScore] )",
            "formatString": "0.0",
            "displayFolder": "Pipeline"
          },
          {
            "name": "Median Days to Reject",
            "expression": "MEDIAN ( ApplicationFacts[DaysToReject] )",
            "formatString": "0",
            "displayFolder": "Pipeline",
            "description": "Days from sending to the rejection, for rejected applications."
          },
          {
            "name": "Follow-ups Due",
            "expression": "CALCULATE ( COUNTROWS ( ApplicationFacts ), ApplicationFacts[NeedsFollowup] = TRUE () )",
            "formatString": "0",
            "displayFolder": "Follow-up",
            "description": "Waiting on the employer for more than 7 days since the last action."
          },
          {
            "name": "Contact Coverage",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( ApplicationFacts ), ApplicationFacts[IsSent] = TRUE (), ApplicationFacts[HasContactEmail] = TRUE () ), [Applications Sent] )",
            "formatString": "0%",
            "displayFolder": "Follow-up",
            "description": "Share of sent applications with a published or verified hiring-contact email."
          }
        ],
        "description": "One row per application (rpt.ApplicationFacts)."
      },
      {
        "name": "GapTags",
        "columns": [
          {
            "name": "ApplicationId",
            "dataType": "int64",
            "sourceColumn": "ApplicationId",
