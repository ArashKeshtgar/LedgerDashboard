        ],
        "partitions": [
          {
            "name": "GapTags",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(SqlServer, SqlDatabase),",
                "    Data = Source{[Schema=\"rpt\",Item=\"GapTags\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Gap Mentions",
            "expression": "COUNTROWS ( GapTags )",
            "formatString": "0",
            "displayFolder": "Gaps"
          },
          {
            "name": "Gap Rejections",
            "expression": "CALCULATE ( COUNTROWS ( GapTags ), ApplicationFacts[IsRejected] = TRUE () )",
            "formatString": "0",
            "displayFolder": "Gaps",
            "description": "Postings listing this gap that ended in a rejection."
          }
        ]
      },
