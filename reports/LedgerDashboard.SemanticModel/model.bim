            "sourceColumn": "Source",
            "summarizeBy": "none"
          },
          {
            "name": "PosterType",
            "dataType": "string",
            "sourceColumn": "PosterType",
            "summarizeBy": "none"
          },
          {
            "name": "AppliedVia",
