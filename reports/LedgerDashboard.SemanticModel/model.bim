        "measures": [
          {
            "name": "Recruiters Added",
            "expression": "COUNTROWS ( Recruiters )",
            "formatString": "0",
            "displayFolder": "Outreach"
          },
          {
            "name": "Connect Requests Sent",
            "expression": "COUNTROWS ( FILTER ( Recruiters, NOT ISBLANK ( Recruiters[ConnectSentOn] ) ) )",
            "formatString": "0",
            "displayFolder": "Outreach"
          },
          {
            "name": "Replies",
            "expression": "COUNTROWS ( FILTER ( Recruiters, NOT ISBLANK ( Recruiters[RepliedOn] ) ) )",
            "formatString": "0",
            "displayFolder": "Outreach"
          }
        ]
