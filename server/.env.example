ANTHROPIC_API_KEY=sk-ant-...

# Only needed for a deployed (non-localhost) instance. Leave both unset for
# local use — no login is required and everything behaves as before.
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Only needed for a deployed instance — points at a mounted persistent
# volume holding the real JobSearch/engine data (never committed to git).
# Leave unset locally; it defaults to the sibling ../../JobSearch folder.
JOBSEARCH_DATA_DIR=
