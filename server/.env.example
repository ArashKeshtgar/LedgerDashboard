ANTHROPIC_API_KEY=sk-ant-...

# Local use: leave everything below unset. With no DASHBOARD_PASSWORD there
# is no login, so the server only listens on 127.0.0.1 (this machine).

# Deployed use: both required. DASHBOARD_PASSWORD is 12+ characters;
# SESSION_SECRET is a different random value of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing SESSION_SECRET logs every device out.
DASHBOARD_PASSWORD=
SESSION_SECRET=
# Optional, for scripts: `Authorization: Bearer <API_TOKEN>` instead of the
# login form. Another distinct random value of 32+ characters.
API_TOKEN=
# Session cookies are Secure (HTTPS-only) in production. Set false only for a
# container reached over plain http on this machine (e.g. Control Panel's
# compose.apps.yml); never behind a public URL.
COOKIE_SECURE=

# Only needed for a deployed instance — points at a mounted persistent
# volume holding the real JobSearch/engine data (never committed to git).
# Leave unset locally; it defaults to the sibling ../../JobSearch folder.
JOBSEARCH_DATA_DIR=

# Optional: interpreter for build.py/validate.py (defaults to the per-user
# Windows Python 3.12 install if present, else python / python3 on PATH).
PYTHON=

# Data store: csv (default) = the files in JobSearch/engine; sql = SQL Server.
# Setting up SQL Server and copying the data over: see README "SQL Server store".
STORE=
DB_SERVER=localhost
DB_NAME=LedgerDashboard
DB_USER=ledger_svc
DB_PASSWORD=
# true for a local SQL Server (self-signed certificate); false for Azure SQL.
DB_TRUST_SERVER_CERT=true
