ANTHROPIC_API_KEY=sk-ant-...

# Local use: leave everything below unset. With no DASHBOARD_PASSWORD there
# is no login, so the server only listens on 127.0.0.1 (this machine).

# Deployed use: both required. DASHBOARD_PASSWORD is 12+ characters;
# SESSION_SECRET is a different random value of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing SESSION_SECRET logs every device out.
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Only needed for a deployed instance — points at a mounted persistent
# volume holding the real JobSearch/engine data (never committed to git).
# Leave unset locally; it defaults to the sibling ../../JobSearch folder.
JOBSEARCH_DATA_DIR=

# Optional: interpreter for build.py/validate.py (defaults to the per-user
# Windows Python 3.12 install if present, else python / python3 on PATH).
PYTHON=
